            "nearest_active_enemy": {"type": "object", "additionalProperties": false, "required": ["candidate_set", "ordering"], "properties": {"candidate_set": {"const": "active_enemy_combatants_opposite_side"}, "ordering": {"const": "minimum_occupied_footprint_hex_distance_between_executor_and_candidate_ascending_then_stable_id"}}},
            "lowest_health_active_ally": {"type": "object", "additionalProperties": false, "required": ["candidate_set", "ordering"], "properties": {"candidate_set": {"const": "active_same_side_combatants_including_executor"}, "ordering": {"const": "exact_integer_rational_cross_multiplication_current_hp_over_max_hp_ascending_then_stable_id"}}},
            "surrounded_active_ally": {"type": "object", "additionalProperties": false, "required": ["candidate_set", "neighborhood", "predicate", "candidate_self_occupancy", "exclusions", "ordering", "terrain_and_boundary_inputs"], "properties": {"candidate_set": {"const": "active_same_side_combatants_including_executor"}, "neighborhood": {"const": "six_adjacent_hexes"}, "predicate": {"const": "distinct_enemy_occupied_hexes_at_least_3_and_distinct_ally_occupied_hexes_zero"}, "candidate_self_occupancy": {"const": "entire_candidate_footprint_excluded_from_ally_occupancy_count"}, "exclusions": {"const": ["ko", "departed", "captured"]}, "ordering": {"const": "enemy_count_descending_then_stable_id"}, "terrain_and_boundary_inputs": {"const": "excluded"}}},
            "all_active_allies": {"type": "object", "additionalProperties": false, "required": ["candidate_set", "ordering", "multi_target"], "properties": {"candidate_set": {"const": "active_same_side_combatants_including_executor"}, "ordering": {"const": "stable_id_ascending"}, "multi_target": {"const": true}}},
