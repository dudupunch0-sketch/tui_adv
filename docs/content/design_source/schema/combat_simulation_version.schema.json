{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "combat_simulation_version.schema.json",
  "title": "Canonical combat simulation version contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "status",
    "effective_date",
    "runtime_status",
    "owners",
    "supported_versions",
    "authoring",
    "unsupported_version",
    "missing_version",
    "fallback"
  ],
  "properties": {
    "contract_id": {
      "const": "combat_simulation_version"
    },
    "status": {
      "const": "canonical"
    },
    "effective_date": {
      "type": "string",
      "minLength": 1
    },
    "runtime_status": {
      "const": "handoff_required"
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_registry",
        "required_version",
        "enforcement"
      ],
      "properties": {
        "code_registry": {
          "const": "gamecore"
        },
        "required_version": {
          "const": "authoring"
        },
        "enforcement": {
          "const": "validator"
        }
      }
    },
    "supported_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "contains": {
        "type": "object",
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "const": "v3"
          }
        }
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "source",
          "current_runtime_observed",
          "features"
        ],
        "properties": {
          "version": {
            "const": "v3"
          },
          "source": {
            "const": "crates/escape-core/src/combat_contract.rs"
          },
          "current_runtime_observed": {
            "const": true
          },
          "features": {
            "const": [
              "deterministic_seed",
              "provenance",
              "spectator_fingerprint",
              "axial_hex"
            ]
          }
        }
      }
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_simulation_version",
        "required_features",
        "compatibility"
      ],
      "properties": {
        "required_simulation_version": {
          "const": "required"
        },
        "required_features": {
          "const": "optional"
        },
        "compatibility": {
          "const": "exact"
        }
      }
    },
    "unsupported_version": {
      "const": "validator_error"
    },
    "missing_version": {
      "const": "validator_error"
    },
    "fallback": {
      "const": "forbidden"
    }
  }
}
