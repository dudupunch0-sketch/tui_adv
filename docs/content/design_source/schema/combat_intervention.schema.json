        "partial_apply_serialization": {"const": "forbidden"},
        "delayed_or_multi_tick_workflow": {"const": "forbidden"},
        "rng_draws": {"const": {"strategy_only": 0, "deterministic_special_effect": 0, "probabilistic_special_effect": 1}},
        "probabilistic_rng": {
          "type": "object", "additionalProperties": false,
          "required": ["namespace", "source", "provenance_required", "canonical_sub_seed_inputs", "canonical_encoding", "draw_index", "forbidden_inputs"],
          "properties": {
            "namespace": {"const": "actual_combat"}, "source": {"const": "deterministic_sub_seed"}, "provenance_required": {"const": true},
            "canonical_sub_seed_inputs": {"const": ["formula_semantic_tag", "rng_namespace", "effective_segment_seed", "simulation_version", "manifest_fingerprint", "segment_index", "pause_tick", "pause_id", "evaluation_fingerprint", "authored_response_id", "formula_id", "normalized_formula_parameters", "resolved_executor_id", "canonical_ordered_target_ids"]},
            "canonical_encoding": {
              "type": "object", "additionalProperties": false,
              "required": ["input", "serialization", "whitespace", "object_key_order", "integer_encoding", "normalized_formula_parameters_key_order", "sub_seed_derivation_hash", "input_fingerprint", "sub_seed", "draw_zero_roll"],
              "properties": {
                "input": {"const": "ordered_tuple_in_declared_input_order"},
                "serialization": {"const": "utf_8_canonical_json_array"},
                "whitespace": {"const": "none"},
                "object_key_order": {"const": "lexicographic"},
                "integer_encoding": {"const": "decimal"},
                "normalized_formula_parameters_key_order": {"const": "lexicographic"},
                "sub_seed_derivation_hash": {"const": "fnv_1a_64_current_v3"}, "input_fingerprint": {"const": "lowercase_16_hex_of_fnv_result"}, "sub_seed": {"const": "same_64_bit_fnv_result"}, "draw_zero_roll": {"const": "sub_seed_mod_100"}
              }
            }, "draw_index": {"const": 0},
            "forbidden_inputs": {"const": ["wall_clock", "frame", "renderer", "forecast"]}
          }
        }
      }
    },
    "registry": {
