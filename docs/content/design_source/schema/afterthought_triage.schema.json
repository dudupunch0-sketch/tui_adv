{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Afterthought Triage Ledger",
  "type": "object",
  "required": ["schema_version", "source", "policy", "coverage", "entries"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "source": {"type": "string"},
    "policy": {"type": "object"},
    "coverage": {"type": "object"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "source_path", "raw_reference", "classification", "candidate_afterthought_ids", "evidence", "confidence", "review_status"],
        "properties": {
          "event_id": {"type": "string"},
          "source_path": {"type": "string"},
          "raw_reference": {"type": "string"},
          "classification": {"enum": ["exact_match", "intentional_no_link", "descriptive_condition", "designer_review_required"]},
          "candidate_afterthought_ids": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "confidence": {"enum": ["high", "medium", "low"]},
          "review_status": {"enum": ["triaged_pending_schema_decision", "approved_as_condition", "needs_designer_review", "approved", "rejected", "superseded"]},
          "condition_summary": {"type": "string"},
          "related_keywords": {"type": "array", "items": {"type": "string"}},
          "topic_keywords": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
