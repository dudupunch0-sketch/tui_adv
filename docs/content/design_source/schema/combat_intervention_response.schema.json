{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "combat_intervention_response.schema.json",
  "title": "Authored combat intervention response payload",
  "description": "Validates only the composite payload portion of an authored response. Contract metadata is validated by combat_intervention.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "strategy_modifier": {"$ref": "#/$defs/strategyModifier"},
    "special_effect": {"$ref": "#/$defs/specialEffect"}
  },
  "anyOf": [
    {"required": ["strategy_modifier"]},
    {"required": ["special_effect"]}
  ],
  "$defs": {
    "specialEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formula_id", "formula_parameters", "executor_selector_id", "target_selector_id", "success", "failure"],
      "properties": {
        "formula_id": {"type": "string", "pattern": "^combat\\.formula\\.v1\\."},
        "formula_parameters": {"type": "object"},
        "executor_selector_id": {"type": "string", "pattern": "^combat\\.selector\\.executor\\.v1\\."},
        "target_selector_id": {"type": "string", "pattern": "^combat\\.selector\\.target\\.v1\\."},
        "success": {"$ref": "#/$defs/outcomeBranch"},
        "failure": {"$ref": "#/$defs/outcomeBranch"}
      }
    },
    "outcomeBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_ids", "outcome_actions"],
      "properties": {
        "effect_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "outcome_actions": {"type": "array", "items": {"$ref": "#/$defs/outcomeAction"}}
      }
    },
    "outcomeAction": {
      "oneOf": [
        {"$ref": "#/$defs/setFlagAction"},
        {"$ref": "#/$defs/createLootEntitlementAction"},
        {"$ref": "#/$defs/grantItemAction"}
      ]
    },
    "setFlagAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "flag_id"],
      "properties": {
        "kind": {"const": "set_flag"},
        "flag_id": {"type": "string"}
      }
    },
    "createLootEntitlementAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "item_id", "source_selector_id", "claim_policy"],
      "properties": {
        "kind": {"const": "create_loot_entitlement"},
        "item_id": {"type": "string"},
        "source_selector_id": {"type": "string", "pattern": "^combat\\.selector\\.target\\.v1\\."},
        "claim_policy": {"enum": ["default_terminal_policy", "always_claimable", "never_claimable"]}
      }
    },
    "grantItemAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "item_id"],
      "properties": {
        "kind": {"const": "grant_item"},
        "item_id": {"type": "string"}
      }
    },
    "strategyModifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "duration", "operations"],
      "properties": {
        "scope": {"$ref": "#/$defs/strategyScope"},
        "duration": {"enum": ["until_replaced", "next_segment"]},
        "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/strategyOperation"}}
      }
    },
    "strategyScope": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": {"kind": {"const": "all_allies"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "role_id"],
          "properties": {"kind": {"const": "role"}, "role_id": {"type": "string"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "combatant_selector_ids"],
          "properties": {
            "kind": {"const": "combatants"},
            "combatant_selector_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^combat\\.selector\\.target\\.v1\\."}}
          }
        }
      ]
    },
    "strategyOperation": {
      "oneOf": [
        {"$ref": "#/$defs/setRoleWeight"},
        {"$ref": "#/$defs/setTargetingRule"},
        {"$ref": "#/$defs/setTargetPolicy"},
        {"$ref": "#/$defs/clearOverride"}
      ]
    },
    "setRoleWeight": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "field", "value"],
      "properties": {
        "kind": {"const": "set_role_weight"},
        "field": {"enum": ["preferred_distance", "aggression", "formation_maintenance", "pursuit_range", "protect_priority", "target_priority", "risk_tolerance", "ability_priority"]},
        "value": {"type": "integer"}
      }
    },
    "setTargetingRule": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "rule_id"],
      "properties": {
        "kind": {"const": "set_targeting_rule"},
        "rule_id": {"type": "string", "pattern": "^combat\\.strategy\\.targeting\\.v1\\."}
      }
    },
    "setTargetPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "policy_id"],
      "properties": {
        "kind": {"const": "set_target_policy"},
        "policy_id": {"type": "string"}
      }
    },
    "clearOverride": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "field"],
      "properties": {
        "kind": {"const": "clear_override"},
        "field": {"enum": ["role_weight", "targeting_rule", "target_policy"]}
      }
    }
  }
}
